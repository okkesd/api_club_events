[Unit]
Description=Import Sinefil's Eye cinema screenings into Evenements
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/docker exec backend python -u -m cinema_job
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=evenements-cinema-import
